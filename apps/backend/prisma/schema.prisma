generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Borrower {
  id               String            @id @default(uuid())
  fullName         String            @map("full_name")
  email            String            @unique
  annualIncome     Float             @map("annual_income")
  monthlyDebt      Float             @map("monthly_debt")
  creditScore      Int               @map("credit_score")
  employmentStatus String            @map("employment_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  calculations     LoanCalculation[]

  @@map("borrowers")
}

model LoanCalculation {
  id             String    @id @default(uuid())
  borrowerId     String?   @map("borrower_id")
  borrower       Borrower? @relation(fields: [borrowerId], references: [id], onDelete: SetNull)
  principal      Float
  annualRate     Float     @map("annual_rate")
  termMonths     Int       @map("term_months")
  monthlyEMI     Float     @map("monthly_emi")
  totalRepayment Float     @map("total_repayment")
  totalInterest  Float     @map("total_interest")
  dtiRatio       Float?    @map("dti_ratio")
  ltvRatio       Float?    @map("ltv_ratio")
  scenarioName   String?   @map("scenario_name")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("loan_calculations")
}

model CreditPolicy {
  id            String   @id @default(uuid())
  policyId      String   @unique @map("policy_id")
  title         String
  section       String
  category      String
  audience      String   // 'borrower' | 'underwriter' | 'all'
  effectiveDate DateTime @map("effective_date")
  version       String
  status        String   // 'current' | 'superseded' | 'draft'
  content       String   @db.Text
  keywords      String[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status, audience])
  @@map("credit_policies")
}

model PreScreeningRecord {
  id             String   @id @default(uuid())
  applicationId  String   @map("application_id")
  applicantName  String   @map("applicant_name")
  category       String   // 'READY_FOR_REVIEW' | 'NEEDS_INFORMATION' | 'MANUAL_REVIEW'
  workflowStatus String   @default("pending") @map("workflow_status") // 'pending' | 'reviewed' | 'needs_more_info'
  principal      Float
  annualRate     Float    @map("annual_rate")
  termMonths     Int      @map("term_months")
  grossIncome    Float    @map("gross_income")
  monthlyDebt    Float    @map("monthly_debt")
  monthlyEMI     Float    @map("monthly_emi")
  totalRepayment Float    @map("total_repayment")
  totalInterest  Float    @map("total_interest")
  dtiPercentage  Float    @map("dti_percentage")
  ltvPercentage  Float?   @map("ltv_percentage")
  summary        String   @db.Text
  findings       Json
  citations      Json
  missingDocs    String[] @map("missing_docs")
  reviewerNotes  String?  @map("reviewer_notes") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([category])
  @@index([workflowStatus])
  @@map("pre_screening_records")
}
