# ==========================================
# LoanLens AI - Local Development Template
# Copy this file to .env before starting the platform
# Never commit real credentials or production secrets
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Local Docker Database Configuration (PostgreSQL 16 + pgvector on host port 5433)
# Note: Host port 5433 avoids conflict with any host-level PostgreSQL instances
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=loanlens_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/loanlens_db?schema=public

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
